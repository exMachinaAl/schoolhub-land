# Contoh HTTPS reverse proxy untuk SchoolHub di Linux.
# Pasang sertifikat sah lewat certbot/ACME lebih dahulu.
server {
  listen 80;
  server_name portal.sekolah.sch.id;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl http2;
  server_name portal.sekolah.sch.id;
  ssl_certificate /etc/letsencrypt/live/portal.sekolah.sch.id/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/portal.sekolah.sch.id/privkey.pem;

  client_max_body_size 100k;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
}
